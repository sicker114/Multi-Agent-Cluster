<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.enterprise.agent.mapper.BizInventoryMapper">

    <!-- 库存明细统计，含安全库存对比（用于库存赤字识别，全参数化只读） -->
    <select id="statInventory" resultType="java.util.Map">
        SELECT
            product_name AS productName,
            category     AS category,
            stock_qty    AS stockQty,
            safety_stock AS safetyStock,
            warehouse    AS warehouse,
            stat_date    AS statDate,
            (stock_qty - safety_stock) AS stockGap
        FROM biz_inventory
        <where>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="statDate != null and statDate != ''">
                AND stat_date = #{statDate}
            </if>
            <if test="deptIds != null and deptIds.size() > 0">
                AND dept_id IN
                <foreach collection="deptIds" item="deptId" open="(" separator="," close=")">
                    #{deptId}
                </foreach>
            </if>
        </where>
        ORDER BY stockGap ASC
    </select>

</mapper>
